// stede.cc on Cloudflare Workers: the app as static assets, /api/* passed to
// the API. Deploy with `npm run deploy` (see docs/deploy.md).
{
  "name": "stede",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "API_ORIGIN": "https://api.stede.cc"
  },
  "routes": [{ "pattern": "stede.cc", "custom_domain": true }]
}
